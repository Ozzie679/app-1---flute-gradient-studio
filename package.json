{
  "name": "flute-gradient-studio",
  "version": "1.0.0",
  "description": "Generate original fluted-glass gradient wallpapers for Mac, iPad, and iPhone.",
  "main": "main.js",
  "author": "Orion",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.orion.flutegradientstudio",
    "productName": "Flute Gradient Studio",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  }
}

{
  "name": "flute-gradient-studio",
  "version": "1.0.0-beta.4",
  "description": "Generate original fluted-glass gradient wallpapers for Mac, iPad, and iPhone.",
  "main": "main.js",
  "author": "Orion",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.orion.flutegradientstudio",
    "productName": "Flute Gradient Studio",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "renderer/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ozzie679",
        "repo": "app-1---flute-gradient-studio"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": "dmg",
      "icon": "build/icon.png",
      "artifactName": "Flute-Gradient-Studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "Flute-Gradient-Studio-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "Flute-Gradient-Studio-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.77",
    "electron-store": "^11.0.2",
    "electron-updater": "~6.2.1",
    "semver": "^7.8.5"
  }
}
